<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte de Datos</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid rgba(43, 224, 88, 0.685); padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <h1>Reporte de Datos Históricos</h1>
    <table>
        <thead>
            <tr>
                <th>Tag Name</th>
                <th>Valor</th>
                <th>Time Stamp</th>
            </tr>
        </thead>
        <tbody>
            {{#each data}}
            <tr>
                <td>{{this.TagName}}</td>
                <td>{{this.Value}}</td>
                <td>{{this.Time_Stamp}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</body>
</html>
