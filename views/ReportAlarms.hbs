<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <style>
      body {
        font-family: "Roboto", sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0rem;
        line-height: 1rem;
        margin: 1rem!important;
      }
      table {
        font-family: "Roboto", sans-serif;
        font-size: 0.75rem;  
        letter-spacing: 0rem;
        line-height: 1rem; 
        width: 100%; 
        border-collapse: collapse;
        border: 1px solid rgb(214 218 220);
      }
      th {
        background-color: rgb(248 250 250);
        font-size:  0.75rem; 
        border: 1px solid rgb(214 218 220);  
        width: 50%;
      }
      td {
        font-size: 0.75rem;   
        text-align: center;
        padding: 0.375rem;
        border: 1px solid rgb(214 218 220);
        width: 50%;
      }
      .document-info {
        display: flex; 
        align-items: left; 
        flex-direction: column; 
      }
      .tag-info {
        display: flex; 
        align-items: center; 
        gap: 0.625rem; 
        margin-top: 2rem;
        margin-bottom: 1rem;
      }
      .alias {
        margin: 0; 
        font-weight: bold;
        font-size: 0.875rem;
      }
      .header {
        display: flex; 
        align-items: center; 
        justify-content: center; 
        height: 100px;
      }
      .d-flex {
        display: flex;
      }
      .d-flex-col {
        display: flex;
        flex-direction: column;
      }
    </style>
  </head>
  <body>
    {{> header }}

    {{#if showChart}}
      {{> chart chartData=chart}}
    {{/if}}

    {{#if showTable}}
      {{> tableAlarms tableData=data}}
    {{/if}}

    {{> footer }}
  </body>
</html>
